# Copy this file to .env and fill in real values locally.
# NEVER commit .env — it is listed in .gitignore.
# Use a long random password for each HQ_DB_*_PASSWORD, e.g.:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Environment ---
APP_ENV=dev            # dev | paper (never "prod" in V1)
HQ_LOG_LEVEL=INFO      # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Database (PostgreSQL in Docker, see docker-compose.yml) ---
HQ_DB_HOST=127.0.0.1
HQ_DB_PORT=5432
HQ_DB_NAME=halal_quant
HQ_DB_ADMIN_USER=hq_admin      # container superuser; used only by the bootstrap command
HQ_DB_ADMIN_PASSWORD=
HQ_DB_MIGRATOR_PASSWORD=       # role hq_migrator: schema changes (Alembic only)
HQ_DB_APP_PASSWORD=            # role hq_app: data read/write, no schema changes
HQ_DB_READONLY_PASSWORD=       # role hq_readonly: SELECT only

# --- Market + fundamentals data: Sharadar via Nasdaq Data Link (ADR-001) ---
HQ_SHARADAR_API_KEY=           # owner enters this themselves — never in chat or git

# --- Sharia cross-check: Zoya API, Personal Use licence, one month (task 15) ---
HQ_ZOYA_API_KEY=               # owner enters this themselves — never in chat or git

# --- IBKR (paper account only in V1) ---
IBKR_ACCOUNT_ID=        # must start with DU (paper) — app must refuse anything else
IBKR_GATEWAY_HOST=127.0.0.1
IBKR_GATEWAY_PORT=4002  # paper port only (4002 or 7497) — never 4001/7496 (live)

# --- App / session security ---
SECRET_KEY=

# --- Alerts ---
ALERT_EMAIL_TO=
ALERT_EMAIL_SMTP_URL=

# --- SEC EDGAR (ETF holdings for the Sharia cross-check): name and contact the SEC may reach ---
HQ_SEC_USER_AGENT=            # e.g. HalalQuantResearch your.email@example.com
