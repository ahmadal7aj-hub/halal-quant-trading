# Copy this file to .env and fill in real values locally.
# NEVER commit .env — it is listed in .gitignore.
# See 02_SECURITY_HANDOFF.md for the full secrets policy.

# --- Environment ---
APP_ENV=dev            # dev | paper (never "prod" in V1)

# --- Database (PostgreSQL) ---
DATABASE_URL=

# --- IBKR (paper account only in V1) ---
IBKR_ACCOUNT_ID=        # must start with DU (paper) — app must refuse anything else
IBKR_GATEWAY_HOST=127.0.0.1
IBKR_GATEWAY_PORT=4002  # paper port only (4002 or 7497) — never 4001/7496 (live)

# --- Sharia data provider (TBD — decision D2) ---
SHARIA_DATA_PROVIDER=
SHARIA_DATA_API_KEY=

# --- Market data provider (TBD — decision D3) ---
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=

# --- App / session security ---
SECRET_KEY=

# --- Alerts ---
ALERT_EMAIL_TO=
ALERT_EMAIL_SMTP_URL=
